[Unit]
Description=Emerald Energy Bridge
After=network.target bluetooth.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/dietpi/emerald-bridge

# Configuration
Environment="DEVICE=YO:UR:MA:CA:DD:RE:SS"
Environment="PAIRING_CODE=XXXXXX"
Environment="MQTT_HOSTNAME=XXXX"
Environment="MQTT_PORT=XXXX"
Environment="MQTT_USERNAME="   #default is no auth, add username and password if relevant to your setup
Environment="MQTT_PASSWORD="
Environment="MQTT_BASE_TOPIC=home/emerald"
# Level 1 is better for long-term running (less log spam)
Environment="DEBUG_LEVEL=1"

# Run command
ExecStart=/usr/bin/python3 /home/dietpi/emerald-bridge/emerald.py

# Restart automatically if it crashes
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
